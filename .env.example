# Core
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
PROMPT_VERSION=v1

# Sources
SOURCES=google_news
KEYWORDS_FILE=config/keywords.txt
GOOGLE_NEWS_LANG=en-US
GOOGLE_NEWS_REGION=US
GOOGLE_NEWS_EDITION=US:en
MAX_ITEMS_PER_KEYWORD=8
OFFICIAL_SOURCES_FILE=config/external_sources.yml
OFFICIAL_MAX_ITEMS=6

# Index monitoring (price indices)
INDEX_ENABLED=1
INDEX_SOURCES_FILE=config/index_sources.yml
INDEX_RAW_DIR=data/indices/raw
INDEX_NORMALIZED_DIR=data/indices/normalized

# Fetching
FETCH_TIMEOUT_SECONDS=20
FETCH_DELAY_SECONDS=1.5
ANALYZE_DELAY_SECONDS=1.5
MIN_CONTENT_CHARS=300
SUMMARY_MIN_CHARS=120

# Output
DATA_DIR=data
STATIC_DIR=static
TEMPLATES_DIR=templates
INDEX_LIMIT=200
SITE_BASE_URL=https://sentinel.dataspices.com

# Context
CONTEXT_WINDOW_DAYS=365
CONTEXT_MAX_ITEMS=6
CONTEXT_MODE=vector
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DOC_TASK=retrieval_document
EMBEDDING_QUERY_TASK=retrieval_query
EMBEDDING_MAX_CHARS=4000
EMBEDDING_MIN_CHARS=80
EMBEDDING_WARMUP_LIMIT=2000
EMBEDDING_DELAY_SECONDS=0.2

# Datasets
DATASETS_DIR=data/datasets
DATASET_MIN_CREDIBILITY=60
DATASET_NEGATIVE_RATIO=0.15
DATASET_MIN_CHARS=200
DATASET_SPLIT_TRAIN=0.8
DATASET_SPLIT_VALID=0.1
DATASET_RANDOM_SEED=42

# Premium
PREMIUM_ENABLED=1
PREMIUM_DIR=data/premium
PREMIUM_TOP_N=3
PREMIUM_MIN_CREDIBILITY=60
PREMIUM_MIN_IMPORTANCE=3
PREMIUM_MIN_QUALITY=60

# Payment (CN)
PAY_WECHAT_QR_URL=https://pic.icon.pp.ua/wechat-pay.jpeg
PAY_ALIPAY_QR_URL=https://pic.icon.pp.ua/alipay.jpeg
PAY_ALIPAY_TOKEN=

# Payment (EN)
PAY_USDT_TRC20=

# PayPal (EN)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=live
PAYPAL_API_BASE=https://api-m.paypal.com

# Pay confirm
PAY_CONFIRM_ENDPOINT=/api/pay/confirm
PAY_CONFIRM_ADMIN_ENDPOINT=/api/pay/confirm_admin
PAY_BARK_URL=
PAY_ADMIN_BASE_URL=
PAY_ADMIN_BASE_URL_EN=
PAY_ADMIN_ORDERS_URL=
PAY_ADMIN_ORDERS_URL_EN=
UNLOCK_EXPIRES_DAYS=7

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=
