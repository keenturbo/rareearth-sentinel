GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

SOURCES=google_news,official
KEYWORDS_FILE=config/keywords.txt
OFFICIAL_SOURCES_FILE=config/external_sources.yml
OFFICIAL_MAX_ITEMS=6

GOOGLE_NEWS_LANG=en-US
GOOGLE_NEWS_REGION=US
GOOGLE_NEWS_EDITION=US:en

MAX_ITEMS_PER_KEYWORD=8
FETCH_TIMEOUT_SECONDS=20
FETCH_DELAY_SECONDS=1.5
ANALYZE_DELAY_SECONDS=1.5
MIN_CONTENT_CHARS=800
SUMMARY_MIN_CHARS=120

DATA_DIR=data
STATIC_DIR=static
TEMPLATES_DIR=templates
INDEX_LIMIT=200

CONTEXT_WINDOW_DAYS=365
CONTEXT_MAX_ITEMS=6
CONTEXT_MODE=vector

EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DOC_TASK=retrieval_document
EMBEDDING_QUERY_TASK=retrieval_query
EMBEDDING_MAX_CHARS=4000
EMBEDDING_MIN_CHARS=80
EMBEDDING_WARMUP_LIMIT=2000
EMBEDDING_DELAY_SECONDS=0.2

DATASETS_DIR=data/datasets
DATASET_MIN_CREDIBILITY=60
DATASET_NEGATIVE_RATIO=0.15
DATASET_MIN_CHARS=200
DATASET_SPLIT_TRAIN=0.8
DATASET_SPLIT_VALID=0.1
DATASET_RANDOM_SEED=42
